; Engine configuration file.

config_version=5

[application]

config/name="Dijimones"
run/main_scene="res://scenes/menu.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.png"
boot_splash/bg_color=Color(0.07, 0.09, 0.16, 1)
boot_splash/image="res://assets/branding/splash.png"
boot_splash/fullsize=false
boot_splash/use_filter=false

[autoload]

DigimonDB="*res://scripts/autoload/digimon_db.gd"
Session="*res://scripts/autoload/session.gd"
Music="*res://scripts/autoload/music.gd"
Net="*res://scripts/autoload/net.gd"

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0

[editor]

export/convert_text_resources_to_binary=false
